# Reports (output, not source)
reports/*
# (No negation is needed for tests/fixtures/track_record/reports/: the
# rule above is `reports/*`, and a pattern containing a mid-string
# slash matches only relative to this file's own directory, so the
# fixture tree was never excluded. Four lines of comment used to
# justify two negations that could not fire — verified by removing
# them and re-running `git check-ignore`.)
# reports/{quarter}/ layout (pinned SPY.csv lives at the same relative path
# a real run would use) -- it is checked-in fixture data, not output.

# User strategy (personal config)
strategy.yaml
strategy.compiled.yaml
portfolio-state.yaml

# Runtime state
.task-state.yaml
.task-run-log.yaml
.portfolio-active

# Environment (secrets)
.env
__pycache__/
*.pyc

# OS
.DS_Store

# mutmut runtime
mutants/
.mutmut-cache/
setup.cfg

# pytest / coverage artifacts
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# skill-iteration workspaces (eval artifacts, not source)
.claude/skills/*-workspace/

# Skill update-check throttle state (machine-local, per scripts/update.py)
.skill-update-check

# Generated per-agent skill adapters — derived from .claude/skills + CLAUDE.md
# + .claude/rules (like strategy.compiled.yaml). Regenerate with
# `python3 -m scripts.distribute sync`; never hand-edit.

# Derived plugin skills (materialized by `distribute sync`, like .agents/) —
# only the skills/ subdir is derived; plugin.json is TRACKED source.

# personal-config backups (same privacy class as the originals)
strategy.yaml.bak*
portfolio-state.yaml.bak*

# codex/superpowers review logs — session scratch, not product
# (docs/superpowers/ is the TRACKED plan+spec tree; this is a different path)
.superpowers/

# Your own track-record data — never commit these.
reports/track-record/
/trade-journal.jsonl
